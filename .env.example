# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server runtime settings
PORT=3000
NODE_ENV="development"

# PostgreSQL Database Connection
# When unset in local development/sandbox, the engine automatically initializes embedded PostgreSQL with PGlite.
# For production Cloud SQL or external PostgreSQL, provide the full connection URI.
DATABASE_URL="postgresql://user:password@localhost:5432/nirware_next?sslmode=prefer"

# Session Security Secret (minimum 32 characters)
SESSION_SECRET="change-this-to-a-secure-random-64-character-secret-in-production"

# CORS & Security
CORS_ORIGIN="*"
STORAGE_PROVIDER="local"

